{
    "mcpServers": {
        "bambi-triggers": {
            "command": "node",
            "args": [
                "./src/mcp-servers/bambi-triggers/server.js"
            ],
            "env": {
                "TRIGGERS_DATA_PATH": "./src/config/triggers.json"
            }
        },
        "hypnosis-tools": {
            "command": "node",
            "args": [
                "./src/mcp-servers/hypnosis-tools/server.js"
            ],
            "env": {
                "HYPNOSIS_FRAMEWORK_PATH": "./src/utils/hypnosis/framework.js"
            }
        },
        "session-memory": {
            "command": "node",
            "args": [
                "./src/mcp-servers/session-memory/server.js"
            ],
            "env": {
                "MEMORY_STORAGE_PATH": "./data/sessions"
            }
        },
        "spiral-generator": {
            "command": "node",
            "args": [
                "./src/mcp-servers/spiral-generator/server.js"
            ],
            "env": {
                "CANVAS_CONFIG_PATH": "./src/config/spirals.json"
            }
        },
        "audio-processor": {
            "command": "node",
            "args": [
                "./src/mcp-servers/audio-processor/server.js"
            ],
            "env": {
                "AUDIO_CACHE_PATH": "./src/public/audio/cache"
            }
        }
    }
}
