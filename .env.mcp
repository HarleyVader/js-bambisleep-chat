# MCP Server Environment Configuration
# Copy to .env and configure your API keys

# GitHub Integration (for repository management)
GITHUB_TOKEN=your_github_personal_access_token_here

# MongoDB Integration (if using MongoDB)
MONGODB_URI=mongodb://localhost:27017/bambisleep

# Stripe Integration (for payment processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Hugging Face Integration (for AI models)
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here

# Azure Quantum Integration (for quantum computing)
AZURE_QUANTUM_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_QUANTUM_RESOURCE_GROUP=your_resource_group_name
AZURE_QUANTUM_WORKSPACE=your_quantum_workspace_name

# Microsoft Clarity Integration (for web analytics)
CLARITY_API_KEY=your_clarity_api_key_here
CLARITY_PROJECT_ID=your_clarity_project_id_here

# HPCC Systems Integration (for ECL)
HPCC_CONNECTION_STRING=your_hpcc_connection_string_here