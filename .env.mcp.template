# =============================================================================
# 📊 MICROSOFT CLARITY INTEGRATION (Web Analytics) 
# =============================================================================
# Clarity Dashboard: https://clarity.microsoft.com/
# Website: bambisleep.chat (CONFIGURED)
CLARITY_API_KEY=your_clarity_api_key_here
CLARITY_PROJECT_ID=your_clarity_project_id_here
CLARITY_WEBSITE_URL=https://bambisleep.chat

# =============================================================================
# 🏭 HPCC SYSTEMS INTEGRATION (Enterprise Data Processing)
# =============================================================================
# ECL (Enterprise Control Language) for big data processing
HPCC_CONNECTION_STRING=your_hpcc_connection_string_here
HPCC_CLUSTER_URL=your_cluster_url_here
HPCC_USERNAME=your_hpcc_username
HPCC_PASSWORD=your_hpcc_password

# =============================================================================
# 📁 FILESYSTEM INTEGRATION (Project File Operations)
# =============================================================================
# Automatically configured - no API keys needed
FILESYSTEM_ROOT_PATH=f:\\js-bambisleep-chat
FILESYSTEM_MAX_DEPTH=5
FILESYSTEM_ALLOWED_EXTENSIONS=.js,.json,.md,.css,.html,.txt,.log

# =============================================================================
# 🔒 SECURITY SETTINGS
# =============================================================================
# Encryption key for sensitive data (generate your own)
MCP_ENCRYPTION_KEY=your_32_character_encryption_key_here
MCP_SESSION_SECRET=your_session_secret_for_auth_here

# Rate limiting settings
MCP_RATE_LIMIT_REQUESTS=100
MCP_RATE_LIMIT_WINDOW=900000

# =============================================================================
# 🛠️ MCP CONFIGURATION SETTINGS
# =============================================================================
# Global MCP settings
MCP_TIMEOUT=30000
MCP_RETRY_ATTEMPTS=3
MCP_LOG_LEVEL=info
MCP_ENABLE_CACHING=true
MCP_CACHE_TTL=3600

# Development vs Production
NODE_ENV=development
MCP_ENVIRONMENT=development

# =============================================================================
# 🎯 BAMBI SLEEP CHAT SPECIFIC SETTINGS
# =============================================================================
# Integration with BambiSleep Chat features
BAMBI_ENABLE_AI_INTEGRATION=true
BAMBI_ENABLE_PAYMENT_FEATURES=false
BAMBI_ENABLE_ANALYTICS=true
BAMBI_ENABLE_FILE_OPERATIONS=true

# =============================================================================
# 📝 SETUP INSTRUCTIONS
