# BambiSleep Chat - Environment Configuration Template
# Copy this file to .env (for development) or .env.production (for production)

# ================================
# NODE ENVIRONMENT
# ================================
# Options: development, production, test
NODE_ENV=development

# ================================
# SERVER CONFIGURATION
# ================================
# Backend server port (default: 6969)
PORT=6969

# Vite development server port (default: 5173)
VITE_PORT=5173

# ================================
# KOKORO TTS CONFIGURATION
# ================================
# Text-to-Speech service endpoints

# Development TTS host (usually localhost for local Kokoro instance)
KOKORO_HOST_DEVELOPMENT=http://localhost

# Production TTS host (your production Kokoro API URL)
# Example: https://your-kokoro-api.com
KOKORO_HOST_PRODUCTION=http://localhost

# Kokoro API port (default: 8880)
KOKORO_PORT=8880

# Default voice for TTS (female voices only supported)
# Options: af_bella, af_nicole, af_sarah, af_sky
KOKORO_DEFAULT_VOICE=af_bella

# ================================
# LM STUDIO CONFIGURATION
# ================================
# AI chat model endpoints

# Development LM Studio host (usually localhost)
LMS_HOST_DEVELOPMENT=http://localhost

# Production LM Studio host (your production LM Studio API URL)
# Example: https://your-lms-api.com
LMS_HOST_PRODUCTION=http://localhost

# LM Studio API port (default: 1234)
LMS_PORT=1234

# Default model name to load
# Example: mlx-community/Llama-3.2-3B-Instruct-4bit
LMS_DEFAULT_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit

# ================================
# WEBSOCKET CONFIGURATION
# ================================
# Socket.io connection settings

# Allow CORS from these origins (comma-separated for multiple)
# Development: http://localhost:5173
# Production: https://your-domain.com
CORS_ORIGIN=http://localhost:5173

# ================================
# OPTIONAL: ADVANCED SETTINGS
# ================================

# Enable debug logging (true/false)
DEBUG=false

# Maximum connections per worker thread
MAX_WORKER_CONNECTIONS=10

# TTS request timeout (milliseconds)
TTS_TIMEOUT=30000

# AI response timeout (milliseconds)
AI_TIMEOUT=60000

# ================================
# TESTING CONFIGURATION
# ================================
# Settings for automated tests

# Run tests in CI mode (skips external service tests)
CI=false

# Test server startup timeout (milliseconds)
TEST_SERVER_TIMEOUT=10000

# ================================
# NOTES
# ================================
#
# Required for basic functionality:
# - NODE_ENV (defaults to 'development' if not set)
#
# Optional but recommended:
# - KOKORO_* settings (for TTS features)
# - LMS_* settings (for AI chat features)
#
# The application will work without Kokoro/LMS configured,
# but TTS and AI features will return 503 errors.
#
# For production deployment:
# 1. Copy this file to .env.production
# 2. Set NODE_ENV=production
# 3. Update all *_PRODUCTION hosts to your actual API URLs
# 4. Configure CORS_ORIGIN to your production domain
# 5. Set appropriate timeouts based on your infrastructure
#
# For development:
# 1. Copy this file to .env
# 2. Keep default localhost settings
# 3. Make sure Kokoro TTS is running on port 8880
# 4. Make sure LM Studio is running on port 1234
#
# For testing:
# 1. Tests will use .env if it exists
# 2. Set CI=true to skip external service tests
# 3. Tests create temporary .env files as needed
