# js-bambisleep-chat Environment Variables
PORT=6969
NODE_ENV=development

# LM Studio Configuration
LMS_HOST=localhost
LMS_PORT=1234

# Kokoro TTS Configuration (Required for TTS functionality)
KOKORO_HOST_DEVELOPMENT=localhost
KOKORO_HOST_PRODUCTION=localhost
KOKORO_PORT=8880
KOKORO_API_KEY=
KOKORO_DEFAULT_VOICE=af_sky+af_bella
TTS_TIMEOUT=30000

# Chat Configuration
MAX_MESSAGE_LENGTH=500
CHAT_HISTORY_LIMIT=100

# Debug Options
DEBUG_MODE=true
LOG_LEVEL=info
