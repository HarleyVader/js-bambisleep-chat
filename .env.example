# ================================
# BambiSleep Chat - Environment Configuration
# ================================
# Copy this file to .env for development or .env.production for production
# All values shown are defaults or examples - adjust for your setup

# ================================
# NODE ENVIRONMENT
# ================================
# Options: development, production, test
NODE_ENV=development

# ================================
# SERVER CONFIGURATION
# ================================
# Server host (default: localhost for development)
SERVER_HOST=localhost

# Server port
PORT=7878

# Vite development server port
VITE_PORT=5173

# ================================
# LM STUDIO AI CONFIGURATION
# ================================
# LM Studio API endpoints for AI chat functionality

# Production LM Studio host (use your production server IP/domain)
LMS_HOST_PRODUCTION=192.168.0.118

# Development LM Studio host (usually localhost)
LMS_HOST_DEVELOPMENT=localhost

# LM Studio port (default: 1234, but 7777 is also common)
LMS_PORT=7777

# Model Configuration
# Target model to load (must exist in LM Studio)
TARGET_MODEL_NAME=l3-sthenomaidblackroot-8b-v1@q4_k_s

# Number of attempts to find/load model before giving up
MAX_SEARCH_ATTEMPTS=3

# Timeout Configuration (in milliseconds)
LMS_MODEL_LOAD_TIMEOUT=30000
LMS_API_CALL_TIMEOUT=120000
LMS_REST_API_TIMEOUT=5000
SESSION_TIMEOUT_MINUTES=15

# Context Window Configuration
MAX_CONTEXT_TOKENS=6144
MAX_COMPLETION_TOKENS=2048

# ================================
# CHAT CONFIGURATION
# ================================
MAX_MESSAGE_LENGTH=500
CHAT_HISTORY_LIMIT=100

# ================================
# KOKORO TTS CONFIGURATION
# ================================
# Text-to-Speech service endpoints (female voices only)

# Production TTS host (use your production server IP/domain)
KOKORO_HOST_PRODUCTION=192.168.0.170

# Development TTS host (same as production for this setup)
KOKORO_HOST_DEVELOPMENT=192.168.0.170

# Kokoro API port (default: 8880)
KOKORO_PORT=8880

# Optional Kokoro API key (if your instance requires authentication)
KOKORO_API_KEY=

# Default voice(s) for TTS - can combine multiple with +
# Available: af_bella, af_nicole, af_sarah, af_sky, af_alloy, af_aoede,
#            af_heart, af_jadzia, af_jessica, af_kore, af_nova, af_river
KOKORO_DEFAULT_VOICE=af_sky+af_bella

# TTS request timeout (milliseconds)
TTS_TIMEOUT=300000

# ================================
# DEBUG & LOGGING
# ================================
DEBUG_MODE=true
LOG_LEVEL=info

# ================================
# TESTING CONFIGURATION
# ================================
# Run tests in CI mode (skips external service connectivity tests)
CI=false

# Test server startup timeout (milliseconds)
TEST_SERVER_TIMEOUT=10000

# ================================
# SECURITY (Optional - Production Only)
# ================================
# HTTPS_REDIRECT=true
# SSL_CERT_PATH=/path/to/certificate.crt
# SSL_KEY_PATH=/path/to/private.key

# CORS origins (comma-separated for multiple origins)
# CORS_ORIGIN=http://localhost:5173,https://your-domain.com

# ================================
# NOTES
# ================================
# Required variables:
# - NODE_ENV (defaults to 'development')
# - PORT (defaults to 6969)
#
# Optional but recommended:
# - Kokoro TTS settings (for voice features)
# - LM Studio settings (for AI chat features)
#
# The app runs without Kokoro/LMS but those features return 503 errors.
#
# For CI/CD testing:
# - Set CI=true to skip external service tests
# - Tests will create mock responses when services unavailable
