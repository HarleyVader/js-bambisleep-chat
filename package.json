{
    "name": "js-bambisleep-chat",
    "version": "0.1.0",
    "description": "Modern Node.js/Express/Socket.io/Vanilla JS chat app with TTS, triggers, spiral animations.",
    "main": "server.js",
    "type": "commonjs",
    "author": "HarleyVader",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HarleyVader/js-bambisleep-chat.git"
    },
    "keywords": [
        "chat",
        "tts",
        "websocket",
        "bambi",
        "triggers",
        "hypnosis",
        "spiral"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "build": "vite build",
        "preview": "vite preview",
        "start": "node server.js",
        "start:dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "nodemon server.js",
        "dev:client": "vite",
        "prod:server": "NODE_ENV=production node server.js",
        "clean": "rimraf node_modules public/dist package-lock.json",
        "lint": "echo \"No linting configured\" && exit 0",
        "test": "node tests/master.test.js",
        "test:env": "node tests/environment.test.js",
        "test:stability": "node tests/stability.test.js",
        "test:resource": "node tests/resource.test.js",
        "test:quick": "node tests/environment.test.js",
        "test:report": "node tests/master.test.js && echo 'Reports generated in tests/reports/'",
        "test:view": "start tests/reports/latest-summary.txt"
    },
    "dependencies": {
        "@lmstudio/sdk": "^1.5.0",
        "axios": "^1.11.0",
        "dotenv": "^17.2.2",
        "express": "^4.18.2",
        "node-fetch": "^2.7.0",
        "socket.io": "^4.7.5",
        "worker-thread": "^1.1.0"
    },
    "devDependencies": {
        "concurrently": "^9.1.0",
        "nodemon": "^3.0.0",
        "rimraf": "^5.0.5",
        "vite": "^7.1.5",
        "ws": "^8.14.2"
    },
    "engines": {
        "node": ">=18"
    }
}
