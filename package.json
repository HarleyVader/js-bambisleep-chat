{
    "name": "js-bambisleep-chat",
    "version": "0.3.0",
    "description": "Modern Node.js/Express/Socket.io/Vanilla JS chat app with TTS, triggers, spiral animations.",
    "main": "src-final/server/server.js",
    "type": "commonjs",
    "author": "HarleyVader",
    "license": "MIT",
    "homepage": "https://bambisleep.chat",
    "bugs": {
        "url": "https://github.com/HarleyVader/js-bambisleep-chat/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HarleyVader/js-bambisleep-chat.git"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/HarleyVader"
    },
    "keywords": [
        "chat",
        "tts",
        "websocket",
        "bambi",
        "triggers",
        "hypnosis",
        "spiral"
    ],
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0",
        "pnpm": ">=8.0.0"
    },
    "volta": {
        "node": "22.19.0",
        "npm": "10.9.0"
    },
    "packageManager": "npm@10.9.0",
    "scripts": {
        "start": "node src-final/server/server.js",
        "build": "node scripts/build.js",
        "build:fast": "node scripts/build.js --skip-tests",
        "build:verbose": "node scripts/build.js --verbose",
        "build:clean": "npm run clean && npm run build",
        "prestart": "npm run test:critical",
        "test": "node tests/unified-test-runner.js",
        "test:env": "node tests/unified-test-runner.js -- --tag=environment",
        "test:architecture": "node tests/unified-test-runner.js -- --tag=architecture",
        "test:stability": "node tests/unified-test-runner.js -- --tag=stability",
        "test:performance": "node tests/unified-test-runner.js -- --tag=performance",
        "test:critical": "node tests/unified-test-runner.js -- --tag=critical",
        "test:mcp": "node tests/unified-test-runner.js -- --tag=mcp",
        "test:mcp:standalone": "node tests/mcp-tools-simple.test.js",
        "test:dropdowns": "node tests/unified-test-runner.js -- --tag=dropdowns",
        "test:verbose": "cross-env TEST_VERBOSE=true node tests/unified-test-runner.js",
        "test:ci": "cross-env TEST_REPORTS=true TEST_EXIT_ON_FAILURE=true node tests/unified-test-runner.js",
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "cross-env NODE_ENV=development nodemon src-final/server/server.js",
        "dev:client": "vite",
        "clean": "node scripts/clean.js",
        "clean:light": "node scripts/clean.js --light",
        "clean:full": "node scripts/clean.js --full",
        "prod:install": "npm ci --production",
        "prod:validate": "npm run test:critical && npm audit --production",
        "prod:start": "NODE_ENV=production node src-final/server/server.js",
        "deploy": "node scripts/deploy.js",
        "deploy:install": "node scripts/deploy.js install",
        "deploy:update": "node scripts/deploy.js update",
        "deploy:status": "node scripts/deploy.js status",
        "deploy:logs": "node scripts/deploy.js logs",
        "validate-service": "node scripts/validate-service.js",
        "lint": "echo 'Linting with ESLint...' && echo 'No linting configured yet'",
        "format": "echo 'Formatting with Prettier...' && echo 'No formatting configured yet'",
        "type-check": "echo 'Type checking...' && echo 'TypeScript not configured'",
        "security": "npm audit --audit-level moderate",
        "update-deps": "npm update && npm audit fix",
        "health-check": "npm run test:critical && npm run security",
        "mcp:start": "node src-final/utils/mcp-manager.js start",
        "mcp:status": "node src-final/utils/mcp-manager.js status",
        "mcp:install": "npm install -g @modelcontextprotocol/server-filesystem && echo 'MCP filesystem server installed'",
        "all": "npm run clean && npm run test:critical && npm run build:fast && npm run dev"
    },
    "dependencies": {
        "@lmstudio/sdk": "^1.5.0",
        "axios": "^1.12.2",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "socket.io": "^4.8.1",
        "worker-thread": "^1.1.0"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "nodemon": "^3.1.10",
        "rimraf": "^6.0.1",
        "vite": "^7.1.12",
        "ws": "^8.18.3"
    }
}