{
    "name": "js-bambisleep-chat",
    "version": "0.3.0",
    "description": "Modern Node.js/Express/Socket.io/React chat app with TTS, triggers, spiral animations.",
    "main": "src/server/server.js",
    "type": "commonjs",
    "author": "HarleyVader",
    "license": "MIT",
    "homepage": "https://bambisleep.chat",
    "bugs": {
        "url": "https://github.com/HarleyVader/js-bambisleep-chat/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HarleyVader/js-bambisleep-chat.git"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/HarleyVader"
    },
    "keywords": [
        "chat",
        "tts",
        "websocket",
        "bambi",
        "triggers",
        "hypnosis",
        "spiral"
    ],
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0",
        "pnpm": ">=8.0.0"
    },
    "volta": {
        "node": "22.19.0",
        "npm": "10.9.0"
    },
    "packageManager": "npm@10.9.0",
    "scripts": {
        "start": "node src/server/server.js",
        "build": "vite build && node scripts/build.js",
        "build:fast": "vite build && node scripts/build.js --skip-tests",
        "preview": "vite preview",
        "prestart": "npm run test:critical",
        "test": "node tests/unified-test-runner.js",
        "test:watch": "node tests/unified-test-runner.js --watch",
        "test:critical": "node tests/unified-test-runner.js --tags=critical",
        "test:ci": "cross-env TEST_REPORTS=true TEST_EXIT_ON_FAILURE=true node tests/unified-test-runner.js",
        "dev": "concurrently --kill-others --prefix-colors \"blue.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "cross-env NODE_ENV=development nodemon --watch src/server --watch src/config --watch src/workers --ext js,json src/server/server.js",
        "dev:client": "vite --host 0.0.0.0 --port 5173",
        "clean": "node scripts/clean.js",
        "deploy": "node scripts/deploy.js",
        "validate-service": "node scripts/validate-service.js",
        "health-check": "npm run test:critical && npm audit --audit-level moderate",
        "mcp": "node src/utils/mcp-manager.js",
        "all": "npm run clean && npm run test:critical && npm run build && npm run dev"
    },
    "dependencies": {
        "@lmstudio/sdk": "^1.5.0",
        "axios": "^1.12.2",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1",
        "worker-thread": "^1.1.0"
    },
    "devDependencies": {
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "nodemon": "^3.1.10",
        "rimraf": "^6.0.1",
        "vite": "^7.1.12",
        "ws": "^8.18.3"
    }
}