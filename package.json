{
    "name": "js-bambisleep-chat",
    "version": "0.1.0",
    "description": "Modern Node.js/Express/Socket.io/React/Vite chat app with TTS, triggers, spiral animations.",
    "main": "server.js",
    "scripts": {
        "dev": "concurrently \"nodemon server.js\" \"vite\"",
        "build": "vite build",
        "start": "node server.js",
        "dev:server": "nodemon server.js",
        "dev:client": "vite"
    },
    "dependencies": {
        "dotenv": "^17.2.2",
        "express": "^4.18.2",
        "react": "^19.1.1",
        "socket.io": "^4.7.5",
        "worker-threads": "^1.0.0"
    },
    "devDependencies": {
        "nodemon": "^3.0.0",
        "vite": "^7.1.5",
        "concurrently": "^9.1.0"
    },
    "engines": {
        "node": ">=18"
    }
}
